# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="file:./prisma/dev.db"

# ── Blockchain network (public — safe for client bundles) ──────────────────────
NEXT_PUBLIC_CHAIN_ID="31337"
NEXT_PUBLIC_CHAIN_NAME="CareProof Local"
NEXT_PUBLIC_RPC_URL="http://127.0.0.1:8545"
NEXT_PUBLIC_CURRENCY_NAME="Ether"
NEXT_PUBLIC_CURRENCY_SYMBOL="ETH"

# ── Smart contract address (set after deploying CareProofRegistry) ─────────────
# Run:  npm run contract:deploy:local
# Then copy the printed address here.
NEXT_PUBLIC_CONTRACT_ADDRESS=""

# ── WalletConnect (optional) ───────────────────────────────────────────────────
# Get a free project ID at https://cloud.walletconnect.com
# Leave blank to use injected wallet only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# ── Deployment key (server-side only — NEVER prefix with NEXT_PUBLIC_) ────────
# Optional: used for scripted contract deployment to local or testnet.
# Use Hardhat's built-in development account for local work instead.
# NEVER use a production wallet private key here.
# NEVER commit this file with a real value.
LOCAL_DEPLOYER_PRIVATE_KEY=""
