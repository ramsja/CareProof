{
  "name": "careproof",
  "version": "1.0.0",
  "private": true,
  "description": "CareProof — Web3 wallet architecture, transaction flows, and on-chain registry for Next.js (Hardhat + Wagmi/Viem)",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "chain": "hardhat node",
    "contract:compile": "hardhat compile",
    "contract:test": "hardhat test",
    "contract:deploy:local": "hardhat run contracts/scripts/deploy.ts --network localhost",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate dev --name init && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "setup:local": "npm run db:setup",
    "indexer": "tsx indexer/src/index.ts",
    "dev:all": "concurrently \"npm run chain\" \"npm run dev\" --names \"chain,next\" --prefix-colors \"yellow,cyan\""
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@prisma/client": "^5.13.0",
    "@tanstack/react-query": "^5.28.0",
    "@tanstack/react-query-devtools": "^5.28.0",
    "clsx": "^2.1.0",
    "dotenv": "^16.4.5",
    "next": "^14.2.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.51.2",
    "tailwind-merge": "^2.2.2",
    "viem": "^2.10.1",
    "wagmi": "^2.9.1",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@playwright/test": "^1.43.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^15.0.2",
    "@testing-library/user-event": "^14.5.2",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^9.1.1",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.3",
    "ethers": "^6.17.0",
    "hardhat": "^2.22.3",
    "hardhat-gas-reporter": "^1.0.10",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "prisma": "^5.13.0",
    "solidity-coverage": "^0.8.17",
    "tailwindcss": "^3.4.3",
    "animatecss-tailwind-adapter": "^2.0.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.3",
    "typechain": "^8.3.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "vitest": "^1.5.0"
  }
}
